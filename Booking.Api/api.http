@baseUrl = http://localhost:5295
@token = paste-token-here
@hotelId = 00000000-0000-0000-0000-000000000001
@roomTypeId = 00000000-0000-0000-0000-000000000002
@bookingId = 00000000-0000-0000-0000-000000000006

### Login
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "username": "customer01",
  "password": "your-password"
}

### Register
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "username": "customer01",
  "password": "your-password",
  "fullName": "Nguyen Van A",
  "phone": "0900000000",
  "address": "Quy Nhon",
  "email": "customer01@example.com",
  "createBy": null
}

### Get Profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}

### Forgot Password
POST {{baseUrl}}/api/users/forgot-password
Content-Type: application/json

{
  "username": "customer01"
}

### Refresh Token
POST {{baseUrl}}/api/users/refresh-token

### Health
GET {{baseUrl}}/api/home/health

### Active Banners
GET {{baseUrl}}/api/banners/active

### Provinces
GET {{baseUrl}}/api/provinces

### Search Hotels
GET {{baseUrl}}/api/hotels/search?keyword=hotel&soKhach=2&ngayNhanPhong=2026-09-25&ngayTraPhong=2026-09-27&page=1&pageSize=10

### Hotel Detail
GET {{baseUrl}}/api/hotels/{{hotelId}}

### Admin Search Hotels
GET {{baseUrl}}/api/hotels/admin/search?keyword=hotel&thanhPho=Quy%20Nhon&soSao=3&trangThai=active&page=1&pageSize=10
Authorization: Bearer {{token}}

### Owner Search Hotels
GET {{baseUrl}}/api/hotels/owner/search?page=1&pageSize=10
Authorization: Bearer {{token}}

### Owner Room Types
GET {{baseUrl}}/api/room-types/owner?khachSanId={{hotelId}}
Authorization: Bearer {{token}}

### Room Types By Hotel
POST {{baseUrl}}/api/room-types/by-hotel
Content-Type: application/json

{
  "khachSanId": "{{hotelId}}",
  "soKhach": 2,
  "ngayNhan": "2026-09-25T14:00:00Z",
  "ngayTra": "2026-09-27T12:00:00Z"
}

### Create Booking
POST {{baseUrl}}/api/bookings
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "khachSanId": "{{hotelId}}",
  "ngayNhanPhong": "2026-09-25T14:00:00Z",
  "ngayTraPhong": "2026-09-27T12:00:00Z",
  "phuongThucThanhToan": "cash",
  "danhSachPhong": [
    {
      "loaiPhongId": "{{roomTypeId}}",
      "soLuong": 1
    }
  ]
}

### Booking History
GET {{baseUrl}}/api/bookings/history?pageIndex=1&pageSize=10
Authorization: Bearer {{token}}

### Owner Bookings
POST {{baseUrl}}/api/bookings/owner
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "khachSanId": "{{hotelId}}",
  "page": 1,
  "pageSize": 10
}

### All Owner Bookings
POST {{baseUrl}}/api/bookings/owner/all
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "page": 1,
  "pageSize": 10
}

### Booking Statistics
POST {{baseUrl}}/api/bookings/owner/statistics
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hotelId": "{{hotelId}}",
  "startDate": "2026-09-01T00:00:00Z",
  "endDate": "2026-09-30T23:59:59Z",
  "status": "confirmed"
}

### Confirm Booking
PUT {{baseUrl}}/api/bookings/{{bookingId}}/confirm
Authorization: Bearer {{token}}

### Check In
PUT {{baseUrl}}/api/bookings/{{bookingId}}/check-in
Authorization: Bearer {{token}}

### Check Out
PUT {{baseUrl}}/api/bookings/{{bookingId}}/check-out
Authorization: Bearer {{token}}

### Owner Commissions
GET {{baseUrl}}/api/commissions/owner
Authorization: Bearer {{token}}

### Owner Wallet History
GET {{baseUrl}}/api/wallet/owner
Authorization: Bearer {{token}}